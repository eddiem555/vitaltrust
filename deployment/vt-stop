#!/bin/sh
# Stop the current user's VitalTrust training instance.
#   vt-stop       — stop this user's instance
#   vt-stop -all  — stop all VitalTrust containers (ubuntu or sudo only)

set -e

vt_user_num() {
  echo "$USER" | sed 's/[^0-9]*//g'
}

vt_host_port() {
  num="$(vt_user_num)"
  if [ -z "$num" ]; then
    num=0
  fi
  echo $((3000 + num))
}

vt_container_name() {
  if [ "$USER" = "ubuntu" ]; then
    echo "vitaltrust-app"
  else
    echo "vitaltrust-${USER}"
  fi
}

vt_public_ip() {
  if [ -n "${VITALTRUST_PUBLIC_IP:-}" ]; then
    echo "$VITALTRUST_PUBLIC_IP"
    return 0
  fi
  if command -v curl >/dev/null 2>&1; then
    curl -4 -fsS --max-time 5 ifconfig.me 2>/dev/null | tr -d '[:space:]'
    return 0
  fi
  echo ""
}

vt_app_url() {
  port="$(vt_host_port)"
  ip="$(vt_public_ip)"
  if [ -z "$ip" ]; then
    echo "(public IP unavailable — check network connectivity or set VITALTRUST_PUBLIC_IP)"
  else
    echo "http://${ip}:${port}"
  fi
}

vt_env_file() {
  if [ -f "$HOME/.env" ]; then
    echo "$HOME/.env"
  fi
}

vt_print_instance_info() {
  state="${1:-unknown}"
  url="$(vt_app_url)"
  env_file="$(vt_env_file)"

  echo "User:       $USER"
  echo "Container:  $(vt_container_name)"
  echo "Host port:  $(vt_host_port) -> container 3000"
  echo "State:      $state"
  echo "URL:        $url"
  if [ -n "$env_file" ]; then
    echo "Env file:   $env_file"
  else
    echo "Env file:   (none — optional $HOME/.env)"
  fi
}

vt_require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "[ERROR] docker is not installed or not on PATH." >&2
    exit 1
  fi
}

vt_can_stop_all() {
  case "$(id -un)" in
    ubuntu|root) return 0 ;;
  esac
  if [ "$(id -u)" -eq 0 ]; then
    return 0
  fi
  return 1
}

vt_stop_all() {
  stopped=0

  if ! vt_can_stop_all; then
    echo "[ERROR] vt-stop -all is restricted to the ubuntu user or sudo." >&2
    echo "        Run as ubuntu or: sudo vt-stop -all" >&2
    exit 1
  fi

  echo "[INFO] Stopping all running VitalTrust containers..."

  docker ps --filter "name=vitaltrust" --format '{{.Names}}' | while read -r name; do
    [ -z "$name" ] && continue
    case "$name" in
      vitaltrust|vitaltrust-* ) ;;
      * ) continue ;;
    esac
    docker stop "$name" >/dev/null
    echo "[INFO] Stopped $name"
    stopped=$((stopped + 1))
  done

  # Subshell counter won't propagate; recount for summary
  running="$(docker ps --filter "name=vitaltrust" --format '{{.Names}}' | wc -l | tr -d ' ')"
  if [ "$running" = "0" ]; then
    echo "[SUCCESS] All VitalTrust instances stopped."
  else
    echo "[WARN] Some containers may still be running. Check: vt-status -all"
    exit 1
  fi
}

vt_require_docker

case "${1:-}" in
  -all|--all)
    vt_stop_all
    exit 0
    ;;
  -h|--help)
    echo "Usage: vt-stop [-all]"
    echo "  vt-stop       Stop this user's VitalTrust instance"
    echo "  vt-stop -all  Stop all VitalTrust instances (ubuntu or sudo only)"
    exit 0
    ;;
  "")
    ;;
  *)
    echo "[ERROR] Unknown option: $1" >&2
    echo "Usage: vt-stop [-all]" >&2
    exit 1
    ;;
esac

CONTAINER="$(vt_container_name)"

if ! docker ps -a --format '{{.Names}}' | grep -Fxq "$CONTAINER"; then
  echo "[INFO] No container named '$CONTAINER'."
  exit 0
fi

if docker ps --format '{{.Names}}' | grep -Fxq "$CONTAINER"; then
  docker stop "$CONTAINER" >/dev/null
  echo "[INFO] Stopped '$CONTAINER'."
else
  echo "[INFO] Container '$CONTAINER' is already stopped."
fi

vt_print_instance_info "stopped"
